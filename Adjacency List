package Graph;
 import java.util.ArrayList;
public class adjacencylist {
   
    ArrayList<ArrayList<Integer>> adj;
    char[] vertex = {'A', 'B', 'C', 'D', 'E', 'F', 'G', 'J', 'K'};

    adjacencylist(int vertices) {
        adj = new ArrayList<>();

        for (int i = 0; i < vertices; i++) {
            adj.add(new ArrayList<Integer>());
        }
    }

    void addEdge(int u, int v) {
        adj.get(u).add(v);
        adj.get(v).add(u);
    }

    void printGraph() {
        for (int i = 0; i < adj.size(); i++) {
            System.out.print(vertex[i] + " -> ");

            for (int j : adj.get(i)) {
                System.out.print(vertex[j] + " ");
            }

            System.out.println();
        }
    }

    public static void main(String[] args) {

        adjacencylist g = new adjacencylist(9);

        g.addEdge(0, 1); 
        g.addEdge(0, 7); 
        g.addEdge(1, 2); 
        g.addEdge(1, 3); 
        g.addEdge(2, 4); 
        g.addEdge(2, 5); 
        g.addEdge(3, 4); 
        g.addEdge(4, 6); 
        g.addEdge(4, 7); 
        g.addEdge(5, 6); 
        g.addEdge(7, 8); 

        g.printGraph();
    }
}

